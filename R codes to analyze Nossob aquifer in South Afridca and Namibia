To load generate a map of groundwater points and plot them [Figure 2]: 
```{r 1st- Groundwater points plotting}

# Install required packages
if (!requireNamespace("rnaturalearth", quietly = TRUE)) {
    install.packages("rnaturalearth")
}
if (!requireNamespace("rnaturalearthdata", quietly = TRUE)) {
    install.packages("rnaturalearthdata")
}
if (!requireNamespace("sf", quietly = TRUE)) {
    install.packages("sf")
}

library(spData)
library(sp)
library(rnaturalearth)
library(rnaturalearthdata)
library(sf)

# Filter out rows with missing values in 'long', 'lat', and 'wl_mbgl'
NossobC <- Nossob[complete.cases(Nossob[, c("long", "lat", "wl_mbgl")]), ]
NossobC <- as.data.frame(NossobC)

# Create SpatialPoints
NossobCsp <- SpatialPoints(NossobC[, c("long", "lat")], proj4string = CRS("+proj=longlat +datum=WGS84"))

# Create SpatialPointsDataFrame
NossobCsp_df <- SpatialPointsDataFrame(coords = coordinates(NossobCsp), data = NossobC)

# Load country boundaries for Namibia and South Africa
countries <- ne_countries(scale = "medium", returnclass = "sf")

# Filter for Namibia and South Africa
namibia_sa <- countries[countries$admin %in% c("Namibia", "South Africa"), ]

# Convert sf object to sp object
namibia_sa_sp <- as(namibia_sa, "Spatial")

# Handle NA values in wl_mbgl
NossobCsp_df <- NossobCsp_df[!is.na(NossobCsp_df$wl_mbgl), ]
NossobCsp_df$wl_mbgl <- as.numeric(as.character(NossobCsp_df$wl_mbgl))

# Check for NA values after conversion
if (any(is.na(NossobCsp_df$wl_mbgl))) {
    stop("There are still NA values in the 'wl_mbgl' column after conversion.")
}

# Define appropriate cuts based on the range of 'wl_mbgl'
cuts <- quantile(NossobCsp_df$wl_mbgl, probs = seq(0, 1, length.out = 6), na.rm = TRUE)

# Set up a palette of interpolated colors
blues <- colorRampPalette(c('yellow', 'orange', 'blue', 'dark blue'))

# Prepare layout for plotting
pols <- list("sp.polygons", namibia_sa_sp, fill = "lightgray")

# Plotting
spplot(NossobCsp_df, 'wl_mbgl', cuts = cuts, col.regions = blues(5), sp.layout = pols, pch = 20, cex = 2)

```






